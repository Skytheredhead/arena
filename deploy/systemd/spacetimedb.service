[Unit]
Description=SpacetimeDB standalone server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skylarenns
Group=skylarenns
WorkingDirectory=/home/skylarenns
Environment=HOME=/home/skylarenns
Environment=PATH=/home/skylarenns/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/home/skylarenns/.local/bin/spacetime start --data-dir /home/skylarenns/.local/share/spacetime/data --jwt-key-dir /home/skylarenns/.config/spacetime --listen-addr 0.0.0.0:4789
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
