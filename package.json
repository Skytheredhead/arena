{
  "name": "arena-ui-shell",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "generate": "pnpm generate:map && pnpm generate:bindings",
    "generate:map": "node scripts/generate-map.mjs",
    "generate:map:check": "node scripts/generate-map.mjs --check",
    "generate:bindings": "bash scripts/generate-bindings.sh",
    "build": "pnpm --filter @arena/client build",
    "build:shared": "pnpm --filter @arena/shared build",
    "build:server": "bash scripts/spacetime-2.1.sh build --module-path apps/server",
    "dev": "pnpm --filter @arena/client dev",
    "lint": "pnpm build:shared && eslint \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/*.ts\"",
    "format": "prettier --write .",
    "test": "pnpm build:shared && pnpm --filter @arena/shared test && pnpm --filter @arena/client test && pnpm test:server",
    "test:server": "bash scripts/test-server.sh",
    "check": "pnpm generate:map:check && pnpm lint && pnpm test && pnpm build && pnpm build:server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.12.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "7.29.7",
      "brace-expansion@<2.0.0": "1.1.16",
      "brace-expansion@>=4.0.0 <6.0.0": "5.0.8",
      "js-yaml@<4.3.0": "4.3.0",
      "picomatch@<3.0.0": "2.3.2",
      "picomatch@>=4.0.0 <5.0.0": "4.0.5",
      "postcss@<8.5.23": "8.5.23",
      "vite@>=6.0.0 <6.4.3": "6.4.3"
    }
  }
}
