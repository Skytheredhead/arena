{
  "name": "arena-ui-shell",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm --filter @arena/client build",
    "dev": "pnpm --filter @arena/client dev",
    "lint": "eslint \"apps/**/*.ts\" \"apps/**/*.tsx\"",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
